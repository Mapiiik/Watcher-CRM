# syntax=docker/dockerfile:1

FROM webdevops/php-nginx:8.4-alpine

ARG buildno
ARG gitcommithash

RUN echo "Build number: $buildno"
RUN echo "Based on commit: $gitcommithash"

ENV WEB_DOCUMENT_ROOT="/app/webroot"

# Copy app data
COPY --chown="${APPLICATION_USER}":"${APPLICATION_USER}" ./ /app

# Install PECL-DBASE extension
RUN set -x \
 && apk add -U --no-cache autoconf gcc libc-dev make \
 && CPPFLAGS="-DHAVE_SYS_FILE_H" pecl install dbase \
 && docker-php-ext-enable dbase \
 && docker-run-bootstrap

# imagick, with the delegates for HEIC, TIFF and PDF, comes from the base image along with
# ghostscript. It is the one that reads what a phone and a scanner send and gd cannot.
#
# It is handed files uploaded from outside, and what it ships with is the open policy - which says
# of itself that it is for a container behind a firewall. Ours names the formats a scan or a
# photograph arrives in and refuses the rest.
COPY docker/imagemagick-policy.xml /etc/ImageMagick-7/policy.xml

# Letting the file into the build context above also let it into `/app`, which is meant to be the
# application and nothing else. It has been read by now and has no business staying there.
RUN rm -rf /app/docker

# Uploads: a signed contract comes back as a handful of scanned pages, and a phone makes them
# large. The base image allows 50M in three places at once, and the smallest of them decides -
# so nginx is raised as well, or it refuses the request before PHP ever sees it. The POST limit
# is the higher of the two because it carries the rest of the form beside the files.
# How many, rather than how large, is its own limit - and the one that says nothing when
# it bites: PHP takes the first `max_file_uploads` of them and drops the rest before the
# application is running. Twenty is the default, and a round of photographs is more.
# The ini sorts after the base image's own 98-webdevops.ini, which is what makes it win. The
# nginx limit is rewritten rather than added to: the directive may not be given twice in one
# context, so a second file holding it stops the server from starting at all.
RUN echo "upload_max_filesize = 250M" > "$PHP_INI_DIR/conf.d/zz-uploads.ini" \
 && echo "post_max_size = 256M" >> "$PHP_INI_DIR/conf.d/zz-uploads.ini" \
 && echo "max_file_uploads = 200" >> "$PHP_INI_DIR/conf.d/zz-uploads.ini" \
 && sed -i "s/^client_max_body_size .*/client_max_body_size 256m;/" /opt/docker/etc/nginx/vhost.common.d/10-general.conf

# Composer install
RUN gosu "${APPLICATION_USER}" composer install -d /app --no-interaction --no-dev --optimize-autoloader

# Add on-start commands
RUN cat <<'EOF' >> /opt/docker/provision/entrypoint.d/99-composer.sh
# Composer operations

# The steps and their order are update.sh's, which does the same work for an installation
# that does not run in a container.
gosu "${APPLICATION_USER}" composer run-script migrations -d /app -- --no-lock

# Link the plugins' assets into the webroot, so the web server serves them itself rather
# than every request for them going through PHP. Here rather than at build time, alongside
# the others, because this is where the application has its environment.
gosu "${APPLICATION_USER}" composer run-script plugin-assets -d /app

# What the code of the previous image left cached. `tmp` is a tmpfs and empties itself, but
# the caches are pointed at Redis, which keeps a volume of its own under a prefix that does
# not change between builds - so translations and the rest outlive the container they were
# written by, for as long as the duration they were written with.
gosu "${APPLICATION_USER}" composer run-script cache-clear -d /app

# Read the new schema once here rather than on somebody's first request. After the clearing,
# not before, or it would throw away what it had just built.
gosu "${APPLICATION_USER}" composer run-script schema-cache -d /app
EOF

RUN chmod +x /opt/docker/provision/entrypoint.d/99-composer.sh

###################################
# ACME TLS certificate management #
###################################
# Install acme.sh and create volume for data
ENV LE_WORKING_DIR="/acme.sh"
ENV LE_CONFIG_HOME="/acme"
VOLUME [ "/acme" ]
RUN curl https://get.acme.sh | sh
RUN ln -s /acme.sh/acme.sh /usr/local/bin/acme.sh

# Set default server name for TLS certificate generation
# (used in self-signed certs and as default domain for ACME)
ENV SERVER_NAME="localhost"

RUN cat <<'EOF' > /opt/docker/provision/entrypoint.d/90-acme.sh
#!/bin/sh
set -e

CERT_DIR="/acme/certs/${SERVER_NAME}"

mkdir -p /opt/docker/etc/nginx/ssl
ln -sf "${CERT_DIR}/fullchain.pem" /opt/docker/etc/nginx/ssl/server.crt
ln -sf "${CERT_DIR}/key.pem"       /opt/docker/etc/nginx/ssl/server.key

if [ ! -f "${CERT_DIR}/fullchain.pem" ]; then
  echo "No certificate found, generating self-signed cert"

  mkdir -p "${CERT_DIR}"

  openssl req -x509 -nodes -newkey rsa:2048 \
    -days 365 \
    -keyout "${CERT_DIR}/key.pem" \
    -out "${CERT_DIR}/fullchain.pem" \
    -subj "/CN=${SERVER_NAME}"
fi
EOF
RUN chmod +x /opt/docker/provision/entrypoint.d/90-acme.sh

RUN cat <<'EOF' > /opt/docker/provision/entrypoint.d/91-acme-renew.sh
#!/bin/sh
set -e

if [ "${SERVER_NAME}" = "localhost" ]; then
  echo "ACME disabled: SERVER_NAME is set to 'localhost'. Set a valid domain to enable automatic TLS certificates."
else
  CERT_DIR="/acme/certs/${SERVER_NAME}"

  acme.sh --set-default-ca --server letsencrypt

  if ! acme.sh --list | grep -q "${SERVER_NAME}"; then
    echo "Certificate for ${SERVER_NAME} not found, issuing new certificate"
    acme.sh --issue \
      -d "${SERVER_NAME}" \
      --webroot "${WEB_DOCUMENT_ROOT}" \
      --key-file "${CERT_DIR}/key.pem" \
      --fullchain-file "${CERT_DIR}/fullchain.pem" \
      --reloadcmd "nginx -t && nginx -s reload"
  else
    echo "Certificate for ${SERVER_NAME} found, attempting renewal if necessary"
  fi

  (
    while true; do
      echo "ACME renew check for ${SERVER_NAME} at $(date)"
      acme.sh --renew -d "${SERVER_NAME}" \
        --reloadcmd "nginx -t && nginx -s reload"
      sleep 12h
    done
  ) &
fi
EOF
RUN chmod +x /opt/docker/provision/entrypoint.d/91-acme-renew.sh
