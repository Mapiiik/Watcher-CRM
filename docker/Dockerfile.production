# syntax=docker/dockerfile:1

############################
# Dependencies
############################
FROM composer:2 AS vendor

WORKDIR /app
COPY composer.json composer.lock ./
# The extensions are the runtime's, checked there against the lock file
RUN composer install \
    --no-dev \
    --no-interaction \
    --no-progress \
    --no-scripts \
    --no-autoloader \
    --ignore-platform-reqs
# the classmap is built from the code, so the code has to be there first
COPY src/ ./src/
COPY plugins/ ./plugins/
RUN composer dump-autoload --no-dev --optimize

############################
# Runtime
############################
# Our FrankenPHP (github.com/Mapiiik/frankenphp): PHP in production settings, the non-root user and
# the Caddyfile with its modes, which app.caddy below fills in
FROM ghcr.io/mapiiik/frankenphp:php8.4

ARG buildno
ARG gitcommithash

# The user the base image brings
ARG APPLICATION_USER=application

LABEL application="Watcher CRM"
LABEL maintainer="github.com/Mapiiik"

RUN echo "Build number: $buildno"
RUN echo "Based on commit: $gitcommithash"

############################
# PHP
############################
RUN install-php-extensions \
    mbstring \
    intl \
    pdo \
    pdo_pgsql \
    simplexml \
    gd \
    imagick \
    redis \
    sockets \
    bcmath \
    dbase \
    opcache

# ImageMagick is handed files uploaded from outside, and what it ships with is the open policy -
# which says of itself that it is for a container behind a firewall. Ours names the formats a scan
# or a photograph arrives in and refuses the rest.
COPY docker/imagemagick-policy.xml /etc/ImageMagick-7/policy.xml

# On top of the production defaults of the base image, what the installations on a server have set
# for their pools. The code does not change inside an image, so OPcache need not look at the files
# again.
RUN echo "memory_limit = 1024M" > $PHP_INI_DIR/conf.d/99-memory.ini \
 && echo "disable_functions = passthru,system" > $PHP_INI_DIR/conf.d/99-disable-functions.ini \
 && { \
      echo "opcache.memory_consumption = 256"; \
      echo "opcache.max_accelerated_files = 20000"; \
      echo "opcache.validate_timestamps = 0"; \
    } > $PHP_INI_DIR/conf.d/99-opcache.ini

# Uploads: a signed contract comes back as a handful of scanned pages, and a phone makes them
# large. The POST limit is the higher of the two because it carries the rest of the form as well.
# How many, rather than how large, is its own limit - and the one that says nothing when
# it bites: PHP takes the first `max_file_uploads` of them and drops the rest before the
# application is running. Twenty is the default, and a round of photographs is more.
RUN echo "upload_max_filesize = 250M" > $PHP_INI_DIR/conf.d/zz-uploads.ini \
 && echo "post_max_size = 256M" >> $PHP_INI_DIR/conf.d/zz-uploads.ini \
 && echo "max_file_uploads = 200" >> $PHP_INI_DIR/conf.d/zz-uploads.ini

# Composer stays for the scripts the container runs on start (composer.json says which)
COPY --from=vendor /usr/bin/composer /usr/local/bin/composer

############################
# Application
############################
COPY --from=vendor --chown=${APPLICATION_USER}:${APPLICATION_USER} /app/vendor /app/vendor
COPY --chown=${APPLICATION_USER}:${APPLICATION_USER} composer.json composer.lock /app/
COPY --chown=${APPLICATION_USER}:${APPLICATION_USER} bin/ /app/bin/
COPY --chown=${APPLICATION_USER}:${APPLICATION_USER} config/ /app/config/
COPY --chown=${APPLICATION_USER}:${APPLICATION_USER} plugins/ /app/plugins/
COPY --chown=${APPLICATION_USER}:${APPLICATION_USER} resources/ /app/resources/
COPY --chown=${APPLICATION_USER}:${APPLICATION_USER} src/ /app/src/
COPY --chown=${APPLICATION_USER}:${APPLICATION_USER} templates/ /app/templates/
COPY --chown=${APPLICATION_USER}:${APPLICATION_USER} webroot/ /app/webroot/

# What `composer install` would have done after installing, skipped above: config/app_local.php
# with a salt of its own, the writable and the data directories. Then whether the extensions
# installed above are what the lock file asks for.
RUN chown ${APPLICATION_USER}:${APPLICATION_USER} /app \
 && su ${APPLICATION_USER} -s /bin/sh -c "composer run-script post-install-cmd --no-interaction -d /app" \
 && composer check-platform-reqs --no-dev -d /app

############################
# Caddy configuration
############################
# The Caddyfile and its modes come with the base image, the application brings its snippets
COPY docker/caddy/app.caddy /etc/frankenphp/app.caddy
ENV SERVER_ROOT=webroot/

############################
# Start
############################
# The steps and their order are update.sh's, which does the same work for an installation that
# does not run in a container.
RUN cat <<'EOF' > /usr/local/bin/docker-entrypoint-custom
#!/bin/sh
set -e

composer run-script migrations -d /app -- --no-lock

# Link the plugins' assets into the webroot, so they are served as files rather than every
# request for them going through PHP. Here rather than at build time, because this is where the
# application has its environment.
composer run-script plugin-assets -d /app

# What the code of the previous image left cached. `tmp` is a tmpfs and empties itself, but the
# caches are pointed at Redis, which outlives the container they were written by.
composer run-script cache-clear -d /app

# Read the new schema once here rather than on somebody's first request. After the clearing,
# not before, or it would throw away what it had just built.
composer run-script schema-cache -d /app

exec docker-php-entrypoint "$@"
EOF

RUN chmod +x /usr/local/bin/docker-entrypoint-custom

ENTRYPOINT ["docker-entrypoint-custom"]
CMD ["--config", "/etc/frankenphp/Caddyfile", "--adapter", "caddyfile"]

############################
# Version
############################
# What git says of the commit the image is built from, for the footer, written by CI as the
# image has neither the repository nor git. Last, as it changes with every build. composer.json
# is copied again only so that a build without the two files has something to copy and goes on.
COPY --chown=${APPLICATION_USER}:${APPLICATION_USER} composer.json VERSION* CHANGELOG* /app/

USER ${APPLICATION_USER}
