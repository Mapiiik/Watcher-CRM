# FrankenPHP, set up like all our Caddy servers: the PROXY protocol is always on, LISTENER_MODE
# picks how Caddy faces the world (see modes/). Based on the default Caddyfile of FrankenPHP.
#
# This file is the same in every image of ours that runs FrankenPHP; what belongs to one
# application is in app.caddy, as the three snippets imported below.
import app.caddy

{
	skip_install_trust
	import modes/{$LISTENER_MODE:direct}/global.caddy

	# The PROXY protocol header is used when it comes from PROXY_ALLOW (by default this machine only)
	# and is optional there, from anywhere else it is ignored. So it stays on, with or without a proxy
	# in front, and nobody else can claim an address.
	servers {
		listener_wrappers {
			proxy_protocol {
				timeout 5s
				allow {$PROXY_ALLOW:127.0.0.1/32 ::1/128}
			}
			tls
		}
	}

	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		import app_frankenphp
		{$FRANKENPHP_CONFIG}
	}
}

{$CADDY_EXTRA_CONFIG}

{$SERVER_NAME:localhost} {
	root {$SERVER_ROOT:public/}
	encode zstd br gzip

	# Defaults an answer gets unless it sets its own. One directive each: defaults in one block
	# are all skipped as soon as the answer sets any one of them.
	header ?Strict-Transport-Security "max-age=31536000"
	header ?X-Content-Type-Options "nosniff"
	header -Server

	import app_site

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	php_server {
		import app_php_server
	}
}

import Caddyfile.d/*.caddyfile
