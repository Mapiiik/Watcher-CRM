# syntax=docker/dockerfile:1

FROM dunglas/frankenphp:php8.4-alpine

ARG buildno
ARG gitcommithash

RUN echo "Build number: $buildno"
RUN echo "Based on commit: $gitcommithash"

ENV DEBUG="true"
ENV SERVER_ROOT="/app/webroot"

# add basic PHP extensions here:
RUN install-php-extensions \
    mbstring \
    intl \
    pdo \
    pdo_pgsql \
    simplexml \
    gd \
    imagick \
    redis \
    sockets

# add additional PHP extensions here:
RUN install-php-extensions \
    bcmath \
	dbase \
    pcov

# ImageMagick is handed files uploaded from outside, and what it ships with is the open policy -
# which says of itself that it is for a container behind a firewall. Ours names the formats a scan
# or a photograph arrives in and refuses the rest.
COPY docker/imagemagick-policy.xml /etc/ImageMagick-7/policy.xml

# Coverage is measured when it is asked for rather than always. pcov costs something on every
# request it is enabled for, and this container mostly serves pages instead of measuring them:
#   php -d pcov.enabled=1 vendor/bin/phpunit --coverage-text
RUN echo "pcov.enabled = 0" > $PHP_INI_DIR/conf.d/pcov.ini

# Install git
RUN set -x \
 && apk add -U --no-cache \
    git

# Production:
#RUN cp $PHP_INI_DIR/php.ini-production $PHP_INI_DIR/php.ini

# Or development:
RUN cp $PHP_INI_DIR/php.ini-development $PHP_INI_DIR/php.ini

# Memory limit 2 GB
RUN echo "memory_limit = 2048M" > $PHP_INI_DIR/conf.d/memory_limit.ini

# Uploads: a signed contract comes back as a handful of scanned pages, and a phone makes them
# large. The POST limit is the higher of the two because it carries the rest of the form as well.
RUN echo "upload_max_filesize = 250M" > $PHP_INI_DIR/conf.d/zz-uploads.ini \
 && echo "post_max_size = 256M" >> $PHP_INI_DIR/conf.d/zz-uploads.ini

# Install Composer globally
#RUN curl -sS https://getcomposer.org/installer | php -- --install-dir=/usr/local/bin --filename=composer
COPY --from=composer:latest /usr/bin/composer /usr/local/bin/composer

# Run as worker (comment out for normal mode)
#ENV FRANKENPHP_CONFIG="worker /app/webroot/index.php"
#ENV MAX_REQUESTS="100"

# Add on-start commands
RUN cat <<'EOF' > /usr/local/bin/docker-entrypoint-custom
#!/bin/sh
set -e

# Composer operations
composer install -d /app
composer run-script migrations -d /app -- --no-lock
composer run-script plugin-assets -d /app
composer run-script schema-cache -d /app

exec docker-php-entrypoint "$@"
EOF

RUN chmod +x /usr/local/bin/docker-entrypoint-custom

ENTRYPOINT ["docker-entrypoint-custom"]
CMD ["--config", "/etc/frankenphp/Caddyfile", "--adapter", "caddyfile"]

# Run as non-root user
ARG APPLICATION_USER=application
RUN \
	adduser -D ${APPLICATION_USER}; \
	# Add additional capability to bind to port 80 and 443
	setcap CAP_NET_BIND_SERVICE=+eip /usr/local/bin/frankenphp; \
	# Give write access to /config/caddy and /data/caddy
	chown -R ${APPLICATION_USER}:${APPLICATION_USER} /config/caddy /data/caddy

USER ${APPLICATION_USER}
