# --- Logging ----------------------------------------------------------------------------------
#export LOG_DEBUG_URL="file://logs/?levels[]=notice&levels[]=info&levels[]=debug&file=debug"
#export LOG_ERROR_URL="file://logs/?levels[]=warning&levels[]=error&levels[]=critical&levels[]=alert&levels[]=emergency&file=error"
# Every query the application runs, written down. Useful while tracking something down, expensive
# to leave on.
#export LOG_QUERIES_URL="file://logs/?levels[]=&scopes[]=queriesLog&file=queries"

# --- DebugKit ---------------------------------------------------------------------------------
# It shows itself when debug is on and the host looks local. These say otherwise: force it on, name a
# domain suffix to count as local, or let it be opened without being logged in.
#export DEBUG_KIT_FORCE_ENABLE="false"
#export DEBUG_KIT_SAFE_TLD=""
#export DEBUG_KIT_IGNORE_AUTHORIZATION="false"
