#!/usr/bin/env bash
# Seeds config/.env, which lets the environment say what differs between one installation
# and the next. Copy this file to config/.env and uncomment the block that loads it in
# config/bootstrap.php.
#
# Keeping .env in production is a **SECURITY RISK** and slows the bootstrap down - there,
# hand the variables to the process itself.
#
# A commented-out line names a variable the application reads but can do without; the value
# shown is the default it falls back on. One marked DEPRECATED is still read, but the place to
# say it has moved - the comment above it says where.

# --- The installation -------------------------------------------------------------------------
export APP_NAME="localhost"
# Where the installation answers. Set it in production: without it the Host header of the
# request decides, and links sent by mail - password resets among them - follow it.
export APP_FULL_BASE_URL="https://localhost"
export APP_COMPANY="TEST"
export DEBUG="true"
export SECURITY_SALT="__SALT__"

export APP_ENCODING="UTF-8"
export APP_DEFAULT_LOCALE="en_US"
export APP_DEFAULT_TIMEZONE="UTC"
#export APP_DEFAULT_CURRENCY="CZK"
#export APP_DEFAULT_PHONE_REGION="CZ"
#export APP_TIME_FORMAT="dd.MM.yyyy HH:mm:ss"
#export APP_DATE_FORMAT="dd.MM.yyyy"

# Where the documents the application keeps for customers are stored.
#export DATA_ROOT="/path/to/data/root"

# --- Databases --------------------------------------------------------------------------------
export DATABASE_URL="postgres://postgres:postgres@127.0.0.1/watcher_crm"
export DATABASE_RADIUS_URL="postgres://postgres:postgres@127.0.0.1/watcher_crm_radius"
export DATABASE_TEST_URL="postgres://postgres:postgres@127.0.0.1/watcher_crm_test"
export DATABASE_TEST_RADIUS_URL="postgres://postgres:postgres@127.0.0.1/watcher_crm_test_radius"

# --- Mail -------------------------------------------------------------------------------------
# Each profile has a transport of its own so that invoices, contracts and support can be sent
# from different mailboxes; a profile left unset falls back on what config/app_local.php names.
#export EMAIL_TRANSPORT_DEFAULT_URL=""
#export EMAIL_DEFAULT_SENDER_EMAIL=""
#export EMAIL_DEFAULT_SENDER_NAME=""
#export EMAIL_DEFAULT_REPLY_TO_EMAIL=""
#export EMAIL_DEFAULT_COPY_TO_EMAIL=""

#export EMAIL_TRANSPORT_INVOICES_URL=""
#export EMAIL_INVOICES_SENDER_EMAIL=""
#export EMAIL_INVOICES_SENDER_NAME=""
#export EMAIL_INVOICES_REPLY_TO_EMAIL=""
#export EMAIL_INVOICES_COPY_TO_EMAIL=""

#export EMAIL_TRANSPORT_CONTRACTS_URL=""
#export EMAIL_CONTRACTS_SENDER_EMAIL=""
#export EMAIL_CONTRACTS_SENDER_NAME=""
#export EMAIL_CONTRACTS_REPLY_TO_EMAIL=""
#export EMAIL_CONTRACTS_COPY_TO_EMAIL=""

#export EMAIL_TRANSPORT_SUPPORT_URL=""
#export EMAIL_SUPPORT_SENDER_EMAIL=""
#export EMAIL_SUPPORT_SENDER_NAME=""
#export EMAIL_SUPPORT_REPLY_TO_EMAIL=""
#export EMAIL_SUPPORT_COPY_TO_EMAIL=""

# Who the scheduled commands report to, space separated.
#export REPORT_EMAILS="space separated"

# --- What the application counts on -----------------------------------------------------------
# The number customers are given, counting up from here.
#export CUSTOMER_SERIES=110000

# A phone number is shown in the summary text with its prefix unless this says otherwise.
export STRIP_PHONE_PREFIX_FOR_SUMMARY_TEXT="false"

# Which address of a range to offer first, and how long an address has to have lain unused
# before it is offered again.
#export OFFSET_OF_FIRST_AVAILABLE_IP_ADDRESS=1
#export MINIMUM_NUMBER_OF_DAYS_SINCE_LAST_USE_FOR_AVAILABLE_IP_ADDRESSES=365

# How a billing period's amount is rounded.
#export BILLING_PERIOD_ROUNDING_PLACES=2
#export BILLING_PERIOD_ROUNDING_TYPE="HALF_UP" # (HALF_UP/CEIL/FLOOR)

# Searchable selects instead of plain ones.
export ENABLE_SELECT2="true"

# --- Watcher Agent ----------------------------------------------------------------------------
# Required for ping and RADIUS disconnect (see README).
#export WATCHER_AGENT_URL="https://127.0.0.1:443"
#export WATCHER_AGENT_TOKEN=""

# --- Watcher NMS ------------------------------------------------------------------------------
# Access points, connection points and what the customer's line runs over. Without both of
# these the pages that show them are simply left empty.
#export WATCHER_NMS_URL="https://nms.example.com"
#export WATCHER_NMS_KEY=""

# --- Addresses --------------------------------------------------------------------------------
# The register the address whisperer asks.
#export ADDRESSES_API_URL=https://addresses.example.com
#export ADDRESSES_API_KEY=watcher-crm:abc123

# --- Maps -------------------------------------------------------------------------------------
# Which mapping stack draws the maps. Only "osm" (Leaflet with OpenStreetMap tiles) is built in.
#export MAP_PROVIDER="osm"

# The address search behind the maps is the Addresses API above, so it needs nothing of its own.
# OpenStreetMap can answer instead - name \Maps\Geocoder\OpenStreetMapGeocoder as `Maps.geocoder`
# in config/app.php, and set these if the public servers are not what you want. The public
# Nominatim wants a User-Agent naming this installation, with a contact address if you can.
#export NOMINATIM_URL="https://nominatim.openstreetmap.org"
#export NOMINATIM_USER_AGENT="Watcher CRM"
#export NOMINATIM_REFERER=""
#export PHOTON_URL="https://photon.komoot.io"

# --- Signing in with Google -------------------------------------------------------------------
#export GOOGLE_OAUTH_CLIENT_ID=""
#export GOOGLE_OAUTH_CLIENT_SECRET=""

# --- RADIUS and the routers -------------------------------------------------------------------
#export RADIUS_SECRET=""
#export RADIUS_DEFAULT_USER_GROUP=""
#export ROUTEROS_USERNAME=""
#export ROUTEROS_PASSWORD=""

# --- Bookkeeping ------------------------------------------------------------------------------
#export POHODA_USERNAME=""
#export POHODA_PASSWORD=""

export EUROFAKTURA_USERNAME=""
export EUROFAKTURA_SECRET_KEY=""
export EUROFAKTURA_TOKEN=""

export EUROFAKTURA_INVOICES_USERNAME=""
export EUROFAKTURA_INVOICES_SECRET_KEY=""
export EUROFAKTURA_INVOICES_TOKEN=""

# DEPRECATED - where each accounting system is reached, and which accounting unit mServer is to
# answer for: the one naming which file the requests land in, so a test one is reached by naming
# it. These belong to the settings now, under `bookkeeping.accounting.providers`, which still
# fall back on them; the trailing comment is the path to set instead.
#export POHODA_MSERVER_URL="http://localhost:44444"        # pohoda.api.url
#export POHODA_COMPANY_ID="00000000"                       # pohoda.api.accounting_unit
export EUROFAKTURA_API_URL="https://e-racuni.com/H7i/API"  # eurofaktura.api.url

# --- Debtors ----------------------------------------------------------------------------------
# DEPRECATED - when a debtor is told, when they are cut off, the label that says they have been,
# and the address list they are written into. These belong to the settings now, under
# `bookkeeping.debtors`, where they can be changed without a deployment. The settings still fall
# back on them, so naming them here goes on working; the trailing comment is the path to set
# instead.
#export DEBTORS_ALLOWED_PAYMENT_DELAY=""      # thresholds.allowed_payment_delay
#export DEBTORS_ALLOWED_TOTAL_OVERDUE_DEBT="" # thresholds.allowed_total_overdue_debt
#export DEBTORS_NOTIFY_DAYS="5,10"            # notifications.days
#export DEBTORS_BLOCKED_LABEL_ID=""           # blocking.blocked_label_id
#export DEBTORS_ADDRESS_LIST="DODGERS"        # blocking.services.routers.address_list

# The routers the blocking is carried out on, and what it signs in with.
#export DEBTORS_ROUTERS_IP_ADDRESSES=""
#export DEBTORS_ROUTERS_USERNAME=""
#export DEBTORS_ROUTERS_PASSWORD=""

# The television service, whose accounts are suspended along with the line.
#export DEBTORS_SLEDOVANITV_USERNAME=""
#export DEBTORS_SLEDOVANITV_PASSWORD=""

# --- SMS --------------------------------------------------------------------------------------
#export ANDROID_SMS_GATEWAY_LOGIN=""
#export ANDROID_SMS_GATEWAY_PASSWORD=""
#export ANDROID_SMS_GATEWAY_PASSPHRASE=""
#export ANDROID_SMS_GATEWAY_URL=""

# --- Cache ------------------------------------------------------------------------------------
# CACHE_DURATION is this file's own shorthand for the lines below it.
#export CACHE_DURATION="+2 minutes"
#export CACHE_DEFAULT_URL="file://tmp/cache/?prefix=${APP_NAME}_default_&duration=${CACHE_DURATION}"
#export CACHE_CAKECORE_URL="file://tmp/cache/persistent?prefix=${APP_NAME}_cake_translations_&serialize=true&duration=${CACHE_DURATION}"
#export CACHE_CAKEMODEL_URL="file://tmp/cache/models?prefix=${APP_NAME}_cake_model_&serialize=true&duration=${CACHE_DURATION}"
#export CACHE_APICLIENT_URL="file://tmp/cache/models?prefix=${APP_NAME}_api_client_&serialize=true&duration=${CACHE_DURATION}"
#export CACHE_ADDRESSES_URL="redis://cache-dev:6379/?database=0&password=redis&prefix=${APP_NAME}_api_addresses_&duration=${CACHE_DURATION}"
#export CACHE_BUSINESS_REGISTER_URL="redis://cache-dev:6379/?database=0&password=redis&prefix=${APP_NAME}_business_register_&duration=${CACHE_DURATION}"

# --- Logging ----------------------------------------------------------------------------------
#export LOG_DEBUG_URL="file://logs/?levels[]=notice&levels[]=info&levels[]=debug&file=debug"
#export LOG_ERROR_URL="file://logs/?levels[]=warning&levels[]=error&levels[]=critical&levels[]=alert&levels[]=emergency&file=error"
# Every query the application runs, written down. Useful while tracking something down, expensive
# to leave on.
#export LOG_QUERIES_URL="file://logs/?levels[]=&scopes[]=queriesLog&file=queries"

# --- DebugKit ---------------------------------------------------------------------------------
# It shows itself when debug is on and the host looks local. These say otherwise: force it on, name a
# domain suffix to count as local, or let it be opened without being logged in.
#export DEBUG_KIT_FORCE_ENABLE="false"
#export DEBUG_KIT_SAFE_TLD=""
#export DEBUG_KIT_IGNORE_AUTHORIZATION="false"
