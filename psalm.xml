<?xml version="1.0"?>
<psalm
    errorLevel="4"
    resolveFromConfigFile="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
    autoloader="config/bootstrap.php"
>
    <projectFiles>
        <directory name="src/"/>
        <directory name="templates/"/>
        <directory name="tests/"/>
        <directory name="plugins/"/>
        <directory name="config/"/>
        <ignoreFiles>
            <directory name="templates/AppUsers/"/>
            <directory name="vendor/"/>
        </ignoreFiles>
    </projectFiles>
    <issueHandlers>
        <UnevaluatedCode>
            <errorLevel type="suppress">
                <file name="config/bootstrap.php"/>
            </errorLevel>
        </UnevaluatedCode>
        <UnusedClass>
            <errorLevel type="suppress">
                <directory name="config/Migrations/"/>
                <directory name="config/Seeds/"/>
                <directory name="src/Controller/"/>
                <directory name="src/Command/"/>
                <directory name="src/Console/"/>
                <directory name="src/Model/"/>
                <directory name="src/View/"/>
                <directory name="tests/"/>
                <directory name="plugins/*/config/Migrations/"/>
                <directory name="plugins/*/src/Controller/"/>
                <directory name="plugins/*/src/Command/"/>
                <directory name="plugins/*/src/View/"/>
                <directory name="plugins/*/tests/"/>
            </errorLevel>
        </UnusedClass>
        <PossiblyUnusedMethod>
            <errorLevel type="suppress">
                <directory name="src/Listener/"/>
                <directory name="src/Mailer/"/>
                <directory name="src/Model/"/>
                <directory name="src/View/"/>
                <directory name="tests/"/>
                <directory name="plugins/*/src/Model/"/>
                <directory name="plugins/*/src/View/"/>
                <directory name="plugins/*/tests/"/>
            </errorLevel>
        </PossiblyUnusedMethod>
    </issueHandlers>
</psalm>
