#: src/Model/Validation/ContractStateValidator.php:103
msgid "The selected contract state cannot be used for new contracts."
msgstr "Vybraný stav smlouvy nelze použít pro nové smlouvy."

#: src/Model/Validation/ContractStateValidator.php:211
msgid "Installation date must be set for this contract state."
msgstr "Pro tento stav smlouvy musí být nastaveno datum instalace."

#: src/Model/Validation/ContractStateValidator.php:229
msgid "Uninstallation date must be set for this contract state."
msgstr "Pro tento stav smlouvy musí být nastaveno datum deinstalace."

#: src/Model/Validation/ContractStateValidator.php:247
msgid "Termination date must be set for this contract state."
msgstr "Pro tento stav smlouvy musí být stanoveno datum ukončení."

#: src/Model/Validation/ContractStateValidator.php:283
msgid ""
"An open task of the required type ({0}) must exist before changing to this "
"contract state."
msgstr ""
"Otevřený úkol požadovaného typu ({0}) musí existovat před změnou na tento "
"stav smlouvy."

#: src/Model/Validation/ContractStateValidator.php:317
msgid "All tasks must be completed before changing to this contract state."
msgstr "Všechny úkoly musí být dokončeny před změnou na tento stav smlouvy."

#: src/Model/Validation/ContractStateValidator.php:350
msgid ""
"Active billings must be finished before changing to this contract state."
msgstr ""
"Aktivní fakturace musí být dokončeny před přechodem na tento stav smlouvy."

#: src/Model/Validation/ContractStateValidator.php:379
msgid "Future billings must be removed before changing to this contract state."
msgstr ""
"Budoucí fakturace musí být odstraněny před změnou na tento stav smlouvy."

#: src/Model/Validation/ContractStateValidator.php:414
msgid ""
"All assigned IP addresses and networks must be removed before changing to "
"this contract state."
msgstr ""
"Všechny přidělené IP adresy a sítě musí být odstraněny před změnou na tento "
"stav smlouvy."

#: src/Model/Validation/ContractStateValidator.php:442
msgid ""
"Active RADIUS accounts must be disabled before changing to this contract "
"state."
msgstr ""
"Aktivní účty RADIUS musí být před změnou na tento stav smlouvy deaktivovány."

#: src/Model/Validation/ContractStateValidator.php:470
msgid ""
"All borrowed equipment must be returned before changing to this contract "
"state."
msgstr ""
"Veškeré zapůjčené zařízení musí být vráceno před změnou na tento stav "
"smlouvy."

#: src/Model/Validation/ContractStateValidator.php:496
msgid "At least one contract version must exist for this contract state."
msgstr "Musí existovat alespoň jedna verze smlouvy pro tento stav smlouvy."

#: src/Model/Validation/ContractStateValidator.php:528
msgid "An active contract version is required for this contract state."
msgstr "Aktivní verze smlouvy je vyžadována pro tento stav smlouvy."

#: src/Model/Validation/ContractStateValidator.php:567
msgid ""
"An active or future contract version is required for this contract state."
msgstr ""
"Aktivní nebo budoucí verze smlouvy je vyžadována pro tento stav smlouvy."

#: src/Model/Validation/ContractStateValidator.php:606
msgid ""
"Active or future contract versions must be terminated or removed before "
"changing to this contract state."
msgstr ""
"Aktivní nebo budoucí verze smlouvy musí být před změnou na tento stav "
"smlouvy ukončeny nebo odstraněny."

#: src/Model/Validation/ContractStateValidator.php:637
msgid ""
"Active contractual obligations must be finished before changing to this "
"contract state."
msgstr ""
"Aktivní smluvní závazky musí být splněny před změnou na tento stav smlouvy."

#: src/Service/ContractPrint/ContractPrintValidator.php:103
msgid "Please select the contract version to be executed."
msgstr "Vyberte prosím verzi smlouvy, kterou chcete uzavřít."

#: src/Service/ContractPrint/ContractPrintValidator.php:124
msgid "Please select the contract version to be terminated."
msgstr "Vyberte prosím verzi smlouvy, kterou chcete ukončit."

#: src/Service/ContractPrint/ContractPrintValidator.php:154
msgid ""
"The contract version to be executed ends on a given date, so the document "
"will be printed as a fixed-term contract. Please confirm that this is "
"intended."
msgstr ""
"Verze smlouvy, která má být uzavřena, má vyplněnou platnost do, takže se "
"dokument vytiskne jako smlouva na dobu určitou. Potvrďte prosím, že je to "
"záměr."

#: src/Service/ContractPrint/ContractPrintValidator.php:170
msgid ""
"A fixed-term contract is its own minimum period of performance. Please set "
"the obligation of the contract version to be executed to the date until "
"which it is valid."
msgstr ""
"Smlouva na dobu určitou je zároveň svou minimální dobou plnění. Nastavte "
"prosím u verze smlouvy, která má být uzavřena, závazek do na stejné datum "
"jako platnost do."

#: src/Service/ContractPrint/ContractPrintValidator.php:195
msgid ""
"A borrowed equipment is not assigned, although it should normally be for "
"this type of service. Please confirm that the customer has their own "
"equipment or add it."
msgstr ""
"Zapůjčené zařízení není přiděleno, ačkoli by normálně mělo být pro tento typ "
"služby. Potvrďte prosím, že zákazník má vlastní zařízení, nebo jej přidejte."

#: src/Service/ContractPrint/ContractPrintValidator.php:222
msgid ""
"IP addresses are not assigned, although they usually should be for this type "
"of service. Please confirm that the customer does not use IP addresses or "
"add them."
msgstr ""
"IP adresy nejsou přiřazeny, přestože by pro tento typ služby obvykle měly "
"být. Potvrďte prosím, že zákazník IP adresy nepoužívá, nebo je doplňte."

#: src/Service/ContractPrint/ContractPrintValidator.php:252
msgid ""
"RADIUS accounts are not assigned, although they usually should be for this "
"type of service. Please confirm that the customer does not use RADIUS "
"accounts or add them."
msgstr ""
"RADIUS účty nejsou přiřazeny, přestože by pro tento typ služby obvykle měly "
"být. Potvrďte prosím, že zákazník RADIUS účty nepoužívá, nebo je doplňte."

#: src/Service/ContractPrint/ContractPrintValidator.php:297
msgid ""
"The contract version to be terminated must differ from the contract version "
"to be executed."
msgstr ""
"Verze smlouvy, která má být ukončena, se musí lišit od verze smlouvy, která "
"má být uzavřena."

#: src/Service/ContractPrint/ContractPrintValidator.php:308
#: src/Service/ContractPrint/ContractPrintValidator.php:373
msgid ""
"Please set the conclusion date of the contract version to be terminated."
msgstr "Nastavte prosím datum uzavření verze smlouvy, která má být ukončena."

#: src/Service/ContractPrint/ContractPrintValidator.php:315
#: src/Service/ContractPrint/ContractPrintValidator.php:380
#: src/Service/ContractPrint/ContractPrintValidator.php:419
msgid "Please enter the contract number to be terminated."
msgstr "Zadejte prosím číslo smlouvy, kterou chcete ukončit."

#: src/Service/ContractPrint/ContractPrintValidator.php:337
msgid "Please enter the effective date of the amendment."
msgstr "Zadejte prosím datum účinnosti dodatku."

#: src/Service/ContractPrint/ContractPrintValidator.php:347
msgid "Please set the conclusion date of the contract version to be executed."
msgstr "Nastavte prosím datum uzavření verze smlouvy, která má být uzavřena."

#: src/Service/ContractPrint/ContractPrintValidator.php:366
#: src/Service/ContractPrint/ContractPrintValidator.php:412
msgid ""
"Please set the date until which the contract version to be terminated is "
"valid."
msgstr ""
"Zadejte prosím datum, do kterého je verze smlouvy, která má být ukončena, "
"platná."

