msgstr "Všechny úkoly musí být dokončeny před změnou na tento stav smlouvy."

#: src/Model/Validation/ContractStateValidator.php:558
msgid ""
"Active billings must be finished before changing to this contract state."
msgstr ""
"Aktivní fakturace musí být dokončeny před přechodem na tento stav smlouvy."

#: src/Model/Validation/ContractStateValidator.php:587
msgid "Future billings must be removed before changing to this contract state."
msgstr ""
"Budoucí fakturace musí být odstraněny před změnou na tento stav smlouvy."

#: src/Model/Validation/ContractStateValidator.php:622
msgid ""
"All assigned IP addresses and networks must be removed before changing to "
"this contract state."
msgstr ""
"Všechny přidělené IP adresy a sítě musí být odstraněny před změnou na tento "
"stav smlouvy."

#: src/Model/Validation/ContractStateValidator.php:650
msgid ""
"Active RADIUS accounts must be disabled before changing to this contract "
"state."
msgstr ""
"Aktivní účty RADIUS musí být před změnou na tento stav smlouvy deaktivovány."

#: src/Model/Validation/ContractStateValidator.php:678
msgid ""
"All borrowed equipment must be returned before changing to this contract "
"state."
msgstr ""
"Veškeré zapůjčené zařízení musí být vráceno před změnou na tento stav "
"smlouvy."

#: src/Model/Validation/ContractStateValidator.php:704
msgid "At least one contract version must exist for this contract state."
msgstr "Musí existovat alespoň jedna verze smlouvy pro tento stav smlouvy."

#: src/Model/Validation/ContractStateValidator.php:736
msgid "An active contract version is required for this contract state."
msgstr "Aktivní verze smlouvy je vyžadována pro tento stav smlouvy."

#: src/Model/Validation/ContractStateValidator.php:775
msgid ""
"An active or future contract version is required for this contract state."
msgstr ""
"Aktivní nebo budoucí verze smlouvy je vyžadována pro tento stav smlouvy."

#: src/Model/Validation/ContractStateValidator.php:814
msgid ""
"Active or future contract versions must be terminated or removed before "
"changing to this contract state."
msgstr ""
"Aktivní nebo budoucí verze smlouvy musí být před změnou na tento stav "
"smlouvy ukončeny nebo odstraněny."

#: src/Model/Validation/ContractStateValidator.php:845
msgid ""
"Active contractual obligations must be finished before changing to this "
"contract state."
msgstr ""
"Aktivní smluvní závazky musí být splněny před změnou na tento stav smlouvy."

