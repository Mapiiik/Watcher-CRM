#: src/Model/Validation/ContractStateValidator.php:114
msgid "The selected contract state cannot be used for new contracts."
msgstr "Vybraný stav smlouvy nelze použít pro nové smlouvy."

#: src/Model/Validation/ContractStateValidator.php:223
msgid "Installation date must be set for this contract state."
msgstr "Pro tento stav smlouvy musí být nastaveno datum instalace."

#: src/Model/Validation/ContractStateValidator.php:242
msgid "Uninstallation date must be set for this contract state."
msgstr "Pro tento stav smlouvy musí být nastaveno datum deinstalace."

#: src/Model/Validation/ContractStateValidator.php:261
msgid "Termination date must be set for this contract state."
msgstr "Pro tento stav smlouvy musí být stanoveno datum ukončení."

#: src/Model/Validation/ContractStateValidator.php:299
msgid ""
"An open task of the required type ({0}) must exist before changing to this "
"contract state."
msgstr ""
"Otevřený úkol požadovaného typu ({0}) musí existovat před změnou na tento "
"stav smlouvy."

#: src/Model/Validation/ContractStateValidator.php:334
msgid "All tasks must be completed before changing to this contract state."
msgstr "Všechny úkoly musí být dokončeny před změnou na tento stav smlouvy."

#: src/Model/Validation/ContractStateValidator.php:368
msgid ""
"Active billings must be finished before changing to this contract state."
msgstr ""
"Aktivní fakturace musí být dokončeny před přechodem na tento stav smlouvy."

#: src/Model/Validation/ContractStateValidator.php:398
msgid "Future billings must be removed before changing to this contract state."
msgstr ""
"Budoucí fakturace musí být odstraněny před změnou na tento stav smlouvy."

#: src/Model/Validation/ContractStateValidator.php:434
msgid ""
"All assigned IP addresses and networks must be removed before changing to "
"this contract state."
msgstr ""
"Všechny přidělené IP adresy a sítě musí být odstraněny před změnou na tento "
"stav smlouvy."

#: src/Model/Validation/ContractStateValidator.php:463
msgid ""
"Active RADIUS accounts must be disabled before changing to this contract "
"state."
msgstr ""
"Aktivní účty RADIUS musí být před změnou na tento stav smlouvy deaktivovány."

#: src/Model/Validation/ContractStateValidator.php:492
msgid ""
"All borrowed equipment must be returned before changing to this contract "
"state."
msgstr ""
"Veškeré zapůjčené zařízení musí být vráceno před změnou na tento stav "
"smlouvy."

#: src/Model/Validation/ContractStateValidator.php:519
msgid "At least one contract version must exist for this contract state."
msgstr "Musí existovat alespoň jedna verze smlouvy pro tento stav smlouvy."

#: src/Model/Validation/ContractStateValidator.php:552
msgid "An active contract version is required for this contract state."
msgstr "Aktivní verze smlouvy je vyžadována pro tento stav smlouvy."

#: src/Model/Validation/ContractStateValidator.php:592
msgid ""
"An active or future contract version is required for this contract state."
msgstr ""
"Aktivní nebo budoucí verze smlouvy je vyžadována pro tento stav smlouvy."

#: src/Model/Validation/ContractStateValidator.php:632
msgid ""
"Active or future contract versions must be terminated or removed before "
"changing to this contract state."
msgstr ""
"Aktivní nebo budoucí verze smlouvy musí být před změnou na tento stav "
"smlouvy ukončeny nebo odstraněny."

#: src/Model/Validation/ContractStateValidator.php:664
msgid ""
"Active contractual obligations must be finished before changing to this "
"contract state."
msgstr ""
"Aktivní smluvní závazky musí být splněny před změnou na tento stav smlouvy."

#: src/Service/ContractPrint/ContractPrintValidator.php:115
msgid "Please select the contract version."
msgstr "Vyberte prosím verzi smlouvy."

#: src/Service/ContractPrint/ContractPrintValidator.php:140
msgid ""
"A borrowed equipment is not assigned, although it should normally be for "
"this type of service. Please confirm that the customer has their own "
"equipment or add it."
msgstr ""
"Zapůjčené zařízení není přiděleno, ačkoli by normálně mělo být pro tento typ "
"služby. Potvrďte prosím, že zákazník má vlastní zařízení, nebo jej přidejte."

#: src/Service/ContractPrint/ContractPrintValidator.php:167
msgid ""
"IP addresses are not assigned, although they usually should be for this type "
"of service. Please confirm that the customer does not use IP addresses or "
"add them."
msgstr ""
"IP adresy nejsou přiřazeny, přestože by pro tento typ služby obvykle měly "
"být. Potvrďte prosím, že zákazník IP adresy nepoužívá, nebo je doplňte."

#: src/Service/ContractPrint/ContractPrintValidator.php:197
msgid ""
"RADIUS accounts are not assigned, although they usually should be for this "
"type of service. Please confirm that the customer does not use RADIUS "
"accounts or add them."
msgstr ""
"RADIUS účty nejsou přiřazeny, přestože by pro tento typ služby obvykle měly "
"být. Potvrďte prosím, že zákazník RADIUS účty nepoužívá, nebo je doplňte."

#: src/Service/ContractPrint/ContractPrintValidator.php:234
msgid "Please select the contract version to be replaced."
msgstr "Vyberte verzi smlouvy, která má být nahrazena."

#: src/Service/ContractPrint/ContractPrintValidator.php:243
msgid ""
"The contract version to be replaced must not be the same as the new contract "
"version."
msgstr "Nahrazovaná verze smlouvy nesmí být stejná jako nová verze smlouvy."

#: src/Service/ContractPrint/ContractPrintValidator.php:252
msgid "Please set the date of conclusion of the original contract version."
msgstr "Nastavte prosím datum uzavření původní verze smlouvy."

#: src/Service/ContractPrint/ContractPrintValidator.php:259
#: src/Service/ContractPrint/ContractPrintValidator.php:324
#: src/Service/ContractPrint/ContractPrintValidator.php:365
msgid "Please enter the number of the contract to be terminated."
msgstr "Zadejte prosím číslo smlouvy, která má být ukončena."

#: src/Service/ContractPrint/ContractPrintValidator.php:281
msgid "Please enter the effective date of the amendment."
msgstr "Zadejte prosím datum účinnosti dodatku."

#: src/Service/ContractPrint/ContractPrintValidator.php:291
#: src/Service/ContractPrint/ContractPrintValidator.php:317
msgid "Please set the date of conclusion of the contract version."
msgstr "Nastavte prosím datum uzavření verze smlouvy."

#: src/Service/ContractPrint/ContractPrintValidator.php:310
#: src/Service/ContractPrint/ContractPrintValidator.php:358
msgid "Please set the date until which the contract version is valid."
msgstr "Nastavte prosím datum, do kterého je verze smlouvy platná."

