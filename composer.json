{
    "name": "mapik/watcher-crm",
    "description": "Watcher CRM",
    "license": "AGPL-3.0-or-later",
    "type": "project",
    "authors": [
        {
            "name": "Martin Patočka",
            "email": "mapik@mapik.net"
        }
    ],
    "homepage": "https://github.com/Mapiiik/Watcher-CRM",
    "support": {
        "issues": "https://github.com/Mapiiik/Watcher-CRM/issues",
        "source": "https://github.com/Mapiiik/Watcher-CRM"
    },
    "require": {
        "php": ">=8.2",
        "cakedc/users": "^16.0",
        "cakephp/cakephp": "^5.3",
        "cakephp/migrations": "^5.1",
        "cakephp/plugin-installer": "^2.0",
        "capcom6/android-sms-gateway": "^2.2",
        "dereuromark/cakephp-audit-stash": "^2.0",
        "dereuromark/cakephp-decimal": "^2.4",
        "doctrine/sql-formatter": "^1.5",
        "evilfreelancer/routeros-api-php": "^1.6",
        "giggsey/libphonenumber-for-php": "^9.0",
        "league/oauth2-google": "^5.0",
        "mapik/pohoda-xml": "^1.25",
        "mapik/radius-client": "^1.1",
        "mlocati/ip-lib": "^1.22",
        "mobiledetect/mobiledetectlib": "^4.10",
        "tecnickcom/tcpdf": "^6.11"
    },
    "require-dev": {
        "cakedc/cakephp-phpstan": "^4.2",
        "cakephp/bake": "^3.6",
        "cakephp/cakephp-codesniffer": "^5.3",
        "cakephp/debug_kit": "^5.2",
        "josegonzalez/dotenv": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5 || ^12.5 || ^13.1",
        "psalm/phar": "^6.16"
    },
    "suggest": {
        "cakephp/repl": "Console tools for a REPL interface for CakePHP applications.",
        "dereuromark/cakephp-ide-helper": "After baking your code, this keeps your annotations in sync with the code evolving from there on for maximum IDE and PHPStan/Psalm compatibility.",
        "markstory/asset_compress": "An asset compression plugin which provides file concatenation and a flexible filter system for preprocessing and minification.",
        "phpstan/phpstan": "PHPStan focuses on finding errors in your code without actually running it. It catches whole classes of bugs even before you write tests for the code."
    },
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "Bookkeeping\\": "plugins/Bookkeeping/src/",
            "Radius\\": "plugins/Radius/src/",
            "Settings\\": "plugins/Settings/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Test\\": "tests/",
            "Bookkeeping\\Test\\": "plugins/Bookkeeping/tests/",
            "Cake\\Test\\": "vendor/cakephp/cakephp/tests/",
            "Radius\\Test\\": "plugins/Radius/tests/",
            "Settings\\Test\\": "plugins/Settings/tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "cakephp/plugin-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true,
            "php-http/discovery": true
        },
        "platform-check": true,
        "sort-packages": true
    },
    "scripts": {
        "post-install-cmd": [
            "App\\Console\\Installer::postInstall"
        ],
        "post-update-cmd": [],
        "post-create-project-cmd": [
            "@migrations",
            "@schema-cache"
        ],
        "check": [
            "@test",
            "@cs-check"
        ],
        "cs-check": "phpcs --colors -p",
        "cs-fix": "phpcbf --colors -p",
        "migrations": [
            "bin/cake migrations migrate --plugin CakeDC/Users",
            "bin/cake migrations migrate",
            "bin/cake migrations migrate --plugin Bookkeeping",
            "bin/cake migrations migrate --plugin Settings"
        ],
        "schema-cache": [
            "bin/cake schema_cache build"
        ],
        "stan": "phpstan analyse",
        "test": "phpunit --colors=always",
        "translations-update": [
            "bin/cake i18n extract --extract-core no --overwrite -p Bookkeeping",
            "bin/cake i18n extract --extract-core no --overwrite -p Radius",
            "bin/cake i18n extract --extract-core no --overwrite -p Settings",
            "bin/cake i18n extract --extract-core yes --overwrite --paths src/,templates/ --output resources/locales/"
        ]
    },
    "extra": {
        "discovery": {
            "psr/http-client-implementation": "Cake\\Http\\Client"
        }
    }
}
