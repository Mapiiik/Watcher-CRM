#: plugins/Access/config/settings.php:15
msgid "Roles held to the stricter rules, together with superusers."
msgstr "Role, na které platí přísnější pravidla, spolu se superuživateli."

#: plugins/Access/config/settings.php:19
msgid "The shortest password an account may be given."
msgstr "Nejkratší heslo, které účet může mít."

#: plugins/Access/config/settings.php:23
msgid "The shortest password of an account held to the stricter rules."
msgstr "Nejkratší heslo účtu, na který platí přísnější pravidla."

#: plugins/Access/config/settings.php:27
msgid ""
"Refuse passwords containing the username or e-mail, repeated or running "
"characters, and the most common passwords."
msgstr ""
"Odmítat hesla s uživatelským jménem nebo e-mailem, s opakujícími se znaky "
"nebo jejich řadou a nejběžnější hesla."

#: plugins/Access/config/settings.php:35
msgid "Everybody signs in with two-step verification."
msgstr "Všichni se přihlašují s dvoufázovým ověřením."

#: plugins/Access/config/settings.php:39
msgid "Accounts held to the stricter rules sign in with two-step verification."
msgstr ""
"Účty, na které platí přísnější pravidla, se přihlašují s dvoufázovým "
"ověřením."

#: plugins/Access/config/settings.php:43
msgid ""
"Failed sign-ins of one account from one address before more are refused for "
"a while."
msgstr ""
"Počet neúspěšných přihlášení jednoho účtu z jedné adresy, po kterém se další "
"na čas odmítají."

#: plugins/Access/config/settings.php:50
msgid ""
"Failed sign-ins from one address, whatever the account, before more are "
"refused."
msgstr ""
"Počet neúspěšných přihlášení z jedné adresy k jakýmkoli účtům, po kterém se "
"další odmítají."

#: plugins/Access/config/settings.php:54
msgid "How long failed sign-ins are remembered and refusals last."
msgstr ""
"Jak dlouho se neúspěšná přihlášení pamatují a jak dlouho odmítání trvá."

#: plugins/Access/src/Authentication/PasswordRules.php:61
msgid "The password has to have at least {0} characters."
msgstr "Heslo musí mít alespoň {0} znaků."

#: plugins/Access/src/Authentication/PasswordRules.php:70
msgid "The password must not contain the username or the e-mail."
msgstr "Heslo nesmí obsahovat uživatelské jméno ani e-mail."

#: plugins/Access/src/Authentication/PasswordRules.php:75
msgid "The password must not be a repeated piece or a run of characters."
msgstr "Heslo nesmí být opakující se úsek ani řada znaků."

#: plugins/Access/src/Authentication/PasswordRules.php:78
msgid "The password is one of the most common ones."
msgstr "Heslo patří mezi nejběžnější."

#: plugins/Access/src/Controller/Trait/ApiTokenTrait.php:64
msgid "The API key of {0} is removed."
msgstr "API klíč účtu {0} byl odebrán."

#: plugins/Access/src/Controller/Trait/OneTimePasswordTrait.php:72
#: plugins/Access/src/Controller/UsersController.php:110
msgid "Too many failed sign-ins. Try again in a few minutes."
msgstr "Příliš mnoho neúspěšných přihlášení. Zkuste to znovu za několik minut."

#: plugins/Access/src/Controller/Trait/OneTimePasswordTrait.php:73
msgid "The code is not right. Please sign in again."
msgstr "Kód je nesprávný. Přihlaste se prosím znovu."

#: plugins/Access/src/Controller/Trait/OneTimePasswordTrait.php:117
#: plugins/Access/src/Controller/Trait/OneTimePasswordTrait.php:154
#: plugins/Access/src/Controller/Trait/OneTimePasswordTrait.php:186
msgid "The code is not right. Please try again."
msgstr "Kód je nesprávný. Zkuste to prosím znovu."

#: plugins/Access/src/Controller/Trait/OneTimePasswordTrait.php:138
msgid "Your account has to use two-step verification."
msgstr "Váš účet musí používat dvoufázové ověření."

#: plugins/Access/src/Controller/Trait/OneTimePasswordTrait.php:150
msgid "Two-step verification is turned off."
msgstr "Dvoufázové ověření je vypnuté."

#: plugins/Access/src/Controller/Trait/OneTimePasswordTrait.php:230
msgid "The two-step verification of {0} is reset."
msgstr "Dvoufázové ověření účtu {0} je resetované."

#: plugins/Access/src/Controller/Trait/PasswordResetTrait.php:54
msgid ""
"If the username or the e-mail belongs to an active account, a link for "
"setting a new password is on its way to its e-mail."
msgstr ""
"Pokud uživatelské jméno nebo e-mail patří aktivnímu účtu, odkaz pro "
"nastavení nového hesla je na cestě na jeho e-mail."

#: plugins/Access/src/Controller/Trait/PasswordResetTrait.php:75
msgid ""
"The link for setting a new password does not work any more. Ask for a new "
"one."
msgstr "Odkaz pro nastavení nového hesla už neplatí. Požádejte o nový."

#: plugins/Access/src/Controller/Trait/PasswordResetTrait.php:98
msgid "The new password is set. Sign in with it."
msgstr "Nové heslo je nastavené. Přihlaste se s ním."

#: plugins/Access/src/Controller/Trait/PasswordResetTrait.php:102
msgid "The password could not be set."
msgstr "Heslo se nepodařilo nastavit."

#: plugins/Access/src/Controller/Trait/SocialAccountsTrait.php:49
msgid "The identity could not be linked. Please try again."
msgstr "Sociální účet se nepodařilo propojit. Zkuste to prosím znovu."

#: plugins/Access/src/Controller/Trait/SocialAccountsTrait.php:85
msgid "The identity at {0} is linked."
msgstr "Sociální účet {0} byl propojen."

#: plugins/Access/src/Controller/Trait/SocialAccountsTrait.php:111
msgid "The identity is unlinked."
msgstr "Propojení sociálního účtu bylo zrušeno."

#: plugins/Access/src/Controller/Trait/SocialAccountsTrait.php:113
msgid "The identity could not be unlinked."
msgstr "Propojení sociálního účtu se nepodařilo zrušit."

#: plugins/Access/src/Controller/UsersController.php:111
msgid "The username or the password is not right."
msgstr "Uživatelské jméno nebo heslo je nesprávné."

#: plugins/Access/src/Controller/UsersController.php:132
msgid ""
"No account here is linked to that identity. Sign in with your password and "
"link it in your profile."
msgstr ""
"S tímto sociálním účtem tu není propojený žádný účet. Přihlaste se heslem a "
"propojte ho ve svém profilu."

#: plugins/Access/src/Controller/UsersController.php:159
msgid "You have signed out."
msgstr "Úspěšně jste se odhlásili."

#: plugins/Access/src/Controller/UsersController.php:196
msgid "Only a superuser changes the password of somebody else."
msgstr "Heslo jiného uživatele může změnit jen superuživatel."

#: plugins/Access/src/Controller/UsersController.php:217
msgid "This is not the current password."
msgstr "Současné heslo je nesprávné."

#: plugins/Access/src/Controller/UsersController.php:220
msgid "The new password has to differ from the current one."
msgstr "Nové heslo se musí lišit od současného."

#: plugins/Access/src/Controller/UsersController.php:229
msgid "The password has been changed."
msgstr "Heslo bylo úspěšně změněno."

#: plugins/Access/src/Controller/UsersController.php:233
msgid "The password could not be changed."
msgstr "Heslo se nepodařilo změnit."

#: plugins/Access/src/Controller/UsersController.php:259
msgid "Only a superuser turns off signing in with a password."
msgstr "Přihlášení heslem vypíná jen superuživatel."

#: plugins/Access/src/Controller/UsersController.php:261
msgid "Signing in to your own account with a password stays on."
msgstr "Přihlášení heslem k vlastnímu účtu vypnout nelze."

#: plugins/Access/src/Controller/UsersController.php:269
msgid "Signing in with a password is off. Setting a password turns it on."
msgstr "Přihlášení heslem je vypnuté. Nastavením hesla se zase zapne."

#: plugins/Access/src/Controller/UsersController.php:336
#: plugins/Access/src/Controller/UsersController.php:360
msgid "The account has been saved."
msgstr "Účet byl uložen."

#: plugins/Access/src/Controller/UsersController.php:340
#: plugins/Access/src/Controller/UsersController.php:364
msgid "The account could not be saved."
msgstr "Účet se nepodařilo uložit."

#: plugins/Access/src/Controller/UsersController.php:382
msgid "The account has been deleted."
msgstr "Účet byl smazán."

#: plugins/Access/src/Controller/UsersController.php:384
