msgid "You are not allowed to open that page."
msgstr "Nemáte oprávnění pro přístup k této stránce."

#: plugins/Access/src/Model/Table/SocialAccountsTable.php:58
msgid "This identity is already linked to another account."
msgstr "Sociální účet je již propojený s jiným uživatelem."

#: plugins/Access/src/Model/Table/UsersTable.php:128
msgid "The two passwords are not the same."
msgstr "Zadaná hesla se neshodují."

