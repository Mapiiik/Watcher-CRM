{
    "name": "mapik/watcher-crm-work-reports",
    "description": "Work reports plugin for Watcher CRM",
    "type": "cakephp-plugin",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "cakephp/cakephp": "^5.0.0",
        "azuyalabs/yasumi": "^2.11"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.1"
    },
    "autoload": {
        "psr-4": {
            "WorkReports\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WorkReports\Test\\": "tests/"
        }
    }
}
