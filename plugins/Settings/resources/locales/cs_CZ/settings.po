#: plugins/Settings/src/Controller/Trait/SettingsControllerTrait.php:30
msgid "Invalid settings path: {path}"
msgstr "Neplatná cesta k nastavení: {path}"

#: plugins/Settings/src/Controller/Trait/SettingsControllerTrait.php:39
msgid "Unknown settings block: {path}"
msgstr "Neznámý blok nastavení: {path}"

#: plugins/Settings/src/Controller/Trait/SettingsControllerTrait.php:55
msgid "The setting has been saved."
msgstr "Nastavení bylo uloženo."

#: plugins/Settings/src/Controller/Trait/SettingsControllerTrait.php:63
msgid "The setting could not be saved. Please, try again."
msgstr "Nastavení nelze uložit. Zkuste to prosím znovu."

#: plugins/Settings/src/Controller/Trait/SettingsControllerTrait.php:72
msgid "The setting {path} could not be saved: {reason}"
msgstr "Nastavení {path} se nepodařilo uložit: {reason}"

#: plugins/Settings/src/ValueObject/Type/ListType.php:150
msgid "A list was expected."
msgstr "Očekával se seznam."

#: plugins/Settings/src/ValueObject/Type/ListType.php:163
msgid "The list is not valid JSON: {reason}"
msgstr "Seznam není platným JSON: {reason}"

#: plugins/Settings/src/ValueObject/Type/ListType.php:170
msgid "A list was expected, not a single value."
msgstr "Očekával se seznam, nikoli jednotlivá hodnota."

#: plugins/Settings/src/ValueObject/Type/ListType.php:187
msgid "A list of items was expected, but the value is keyed."
msgstr "Očekával se seznam položek, ale hodnota je zadána s klíčem."

#: plugins/Settings/src/ValueObject/Type/ListType.php:197
msgid "Item {position} of the list is not of type {type}."
msgstr "Položka {position} v seznamu není typu {type}."

#: plugins/Settings/src/ValueObject/Type/NumberType.php:165
msgid "A number was expected."
msgstr "Očekávalo se číslo."

#: plugins/Settings/src/ValueObject/Type/NumberType.php:172
msgid "A whole number was expected."
msgstr "Očekávalo se celé číslo."

#: plugins/Settings/src/ValueObject/Type/NumberType.php:179
msgid "At most {scale} decimal places were expected."
msgstr "Očekávalo se maximálně {scale} desetinných míst."
