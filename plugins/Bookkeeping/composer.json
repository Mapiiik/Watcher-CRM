{
    "name": "mapik/watcher-crm-bookkeeping",
    "description": "Bookkeeping plugin for Watcher CRM",
    "type": "cakephp-plugin",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "cakephp/cakephp": "^5.0.0",
        "mapik/pohoda-xml": "^1.16"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.1"
    },
    "autoload": {
        "psr-4": {
            "Bookkeeping\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bookkeeping\\Test\\": "tests/",
            "Cake\\Test\\": "vendor/cakephp/cakephp/tests/"
        }
    }
}
