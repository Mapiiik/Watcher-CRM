{
    "name": "mapik/watcher-crm-files",
    "description": "Files plugin for Watcher CRM",
    "type": "cakephp-plugin",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "cakephp/cakephp": "^5.0.0",
        "league/flysystem": "^3.36"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.1"
    },
    "autoload": {
        "psr-4": {
            "Files\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Files\Test\\": "tests/",
            "Cake\Test\\": "vendor/cakephp/cakephp/tests/"
        }
    }
}
