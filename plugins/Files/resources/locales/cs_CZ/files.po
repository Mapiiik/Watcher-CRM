msgstr "{0} je větší, než tento server zvládne najednou."

#: plugins/Files/src/Service/FiledPages.php:314
msgid "{0} only arrived in part."
msgstr "{0} dorazil jen zčásti."

#: plugins/Files/src/Service/FiledPages.php:315
msgid "{0} could not be taken in."
msgstr "{0} se nepodařilo převzít."

#: plugins/Files/src/Service/FiledPages.php:334
msgid "The uploaded file could not be read."
msgstr "Nahraný soubor se nepodařilo přečíst."

#: plugins/Files/src/Service/FiledPages.php:355
msgid "A {0} is not a document that can be filed."
msgstr "{0} není dokument, který jde založit."

#: plugins/Files/src/View/Helper/PreviewHelper.php:102
msgid "Look through ({0})"
msgstr "Prohlédnout ({0})"

#: plugins/Files/src/View/Helper/UploadHelper.php:72
msgid ""
"%d files are chosen and this server takes at most {0} at once. Choose fewer, "
"or send them in more than one batch."
msgstr ""
"Vybráno je %d souborů a tento server jich přijme najednou nejvýš {0}. "
"Vyberte jich méně, nebo je pošlete ve více dávkách."

#: plugins/Files/src/View/Helper/UploadHelper.php:84
msgid ""
"%s are chosen and this server takes at most {0} in one go. Send them in more "
"than one batch."
msgstr ""
"Vybráno je %s a tento server jich najednou přijme nejvýše {0}. Pošlete je na "
"víc dávek."

