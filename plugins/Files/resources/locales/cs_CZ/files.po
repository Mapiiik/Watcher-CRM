#: plugins/Files/src/Command/CheckFilesCommand.php:85
msgid ""
"Checks the stored content against what the records say, and reports what does not match."
msgstr "Porovná uložený obsah s tím, co říká evidence, a nahlásí, co nesedí."

#: plugins/Files/src/Command/CheckFilesCommand.php:91
msgid "Throw away the bytes nobody has a row for. Nothing else is touched."
msgstr "Zahodit bajty, ke kterým nikdo nemá řádek. Ničeho jiného se to nedotkne."

#: plugins/Files/src/Command/CheckFilesCommand.php:135
msgid "{0} rows, {1} of them with their content stored."
msgstr "Řádků {0}, z toho {1} s uloženým obsahem."

#: plugins/Files/src/Command/CheckFilesCommand.php:137
msgid "Rows whose bytes are gone"
msgstr "Řádky, jejichž bajty zmizely"

#: plugins/Files/src/Command/CheckFilesCommand.php:142
msgid "Rows whose bytes are not the size they say"
msgstr "Řádky, jejichž bajty nemají udanou velikost"

#: plugins/Files/src/Command/CheckFilesCommand.php:147
msgid "Bytes nobody has a row for"
msgstr "Bajty, ke kterým nikdo nemá řádek"

#: plugins/Files/src/Command/CheckFilesCommand.php:150
msgid ""
"{0} rows nothing points at. They are safe to let go of one at a time from the storage "
"page."
msgstr "Na {0} řádků nic neukazuje. Lze je po jednom odebrat na stránce úložiště."

#: plugins/Files/src/Command/CheckFilesCommand.php:162
msgid "{0} thrown away."
msgstr "Zahozeno: {0}."

#: plugins/Files/src/Command/CheckFilesCommand.php:168
msgid "The store and the records agree."
msgstr "Úložiště a evidence se shodují."

#: plugins/Files/src/Command/CheckFilesCommand.php:169
msgid "Nothing is missing. Run this again with --fix to throw the rest away."
msgstr "Nic nechybí. Zbytek zahodí opakované spuštění s --fix."

#: plugins/Files/src/Command/CheckFilesCommand.php:191
msgid "The store no longer holds everything the records point at."
msgstr "Úložiště už nedrží všechno, na co evidence ukazuje."

#: plugins/Files/src/Command/CheckFilesCommand.php:193
msgid "Rows whose bytes are gone: {0}"
msgstr "Řádky, jejichž bajty zmizely: {0}"

#: plugins/Files/src/Command/CheckFilesCommand.php:194
msgid "Rows whose bytes are not the size they say: {0}"
msgstr "Řádky, jejichž bajty nemají udanou velikost: {0}"

#: plugins/Files/src/Command/CheckFilesCommand.php:196
msgid ""
"Run `bin/cake check_files` to see which. What is missing has to come back from a backup "
"- neither can be put right from there."
msgstr ""
"Které to jsou, ukáže `bin/cake check_files`. Co chybí, se musí vrátit ze zálohy, "
"odtamtud to spravit nejde."

#: plugins/Files/src/Command/CheckFilesCommand.php:204
msgid "File store check failed"
msgstr "Kontrola úložiště souborů selhala"

#: plugins/Files/src/Command/CheckFilesCommand.php:253
msgid "  ... and {0} more."
msgstr "  ... a dalších {0}."

#: plugins/Files/src/Controller/DocumentsController.php:135
msgid "The content of this document is not in the store."
msgstr "Obsah tohoto dokumentu není v úložišti."

#: plugins/Files/src/Controller/DocumentsController.php:170
msgid "The document has been removed."
msgstr "Dokument byl odebrán."

#: plugins/Files/src/Controller/DocumentsController.php:172
msgid "The document could not be removed: {0}"
msgstr "Dokument se nepodařilo odebrat: {0}"

#: plugins/Files/src/Model/Table/FilesTable.php:86
msgid "The hash of the content is written in hexadecimal."
msgstr "Otisk obsahu je zapsaný šestnáctkově."

