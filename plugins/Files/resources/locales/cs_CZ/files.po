msgstr[2] "Bylo založeno {0} souborů."

#: plugins/Files/src/Model/Table/DocumentationsTable.php:123
msgid ""
"A documentation needs a name or a day. With neither there is nothing to tell "
"it from the next one of its type."
msgstr ""
"Dokumentace potřebuje název nebo den. Bez obojího ji není čím odlišit od "
"další dokumentace téhož typu."

#: plugins/Files/src/Model/Table/DocumentationsTable.php:193
msgid "This documentation type is filed under the day it is about."
msgstr "Tento typ dokumentace se zakládá ke dni, kterého se týká."

#: plugins/Files/src/Model/Table/FilesTable.php:86
msgid "The hash of the content is written in hexadecimal."
msgstr "Otisk obsahu je zapsaný šestnáctkově."

#: plugins/Files/src/Service/FiledPages.php:226
msgid ""
"This server takes at most {0} files at once, so whatever was chosen beyond "
"that never arrived. Send the rest as a second batch."
msgstr ""
"Tento server přijme najednou nejvýš {0} souborů, takže co bylo vybráno nad "
"tento počet, vůbec nedorazilo. Zbytek pošlete jako druhou dávku."

#: plugins/Files/src/Service/FiledPages.php:305
msgid "The file"
msgstr "Soubor"

#: plugins/Files/src/Service/FiledPages.php:309
